; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AMeal Planner"
config/version="2.2.1"
run/main_scene="res://ui/MainWindow.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.9764706, 0.972549, 0.9529412, 1)
boot_splash/show_image=false
config/icon="res://assets/icons/icon.png"

[autoload]

Layout="*res://autoload/Layout.gd"
DataStore="*res://autoload/DataStore.gd"
Palette="*res://autoload/Palette.gd"
AppState="*res://autoload/AppState.gd"
Session="*res://autoload/Session.gd"
Sync="*res://services/SyncEngine.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

textures/vram_compression/import_etc2_astc=true
